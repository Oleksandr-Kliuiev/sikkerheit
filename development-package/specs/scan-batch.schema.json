{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sikkerheit Agent Scan Batch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "scanId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "agentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "scanRequestId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "./observation.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "scanId",
    "sequence",
    "agentVersion",
    "policyVersion",
    "startedAt",
    "completedAt",
    "observations"
  ],
  "description": "DeviceId и OrganizationId определяются аутентификацией. Byte limit, idempotency, sequence и время проверяются сервером дополнительно."
}
