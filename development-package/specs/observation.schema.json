                "minLength": 1,
                "maxLength": 2,
                "pattern": "^[A-Z]:$"
              },
              "role": {
                "const": "os"
              }
            },
            "required": [
              "type",
              "volumeId",
              "role"
            ]
          }
        }
      }
    },
