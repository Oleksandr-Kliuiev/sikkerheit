                          "rawState": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  ]
                },
                "minItems": 0,
                "maxItems": 10,
                "description": "Больше 10 продуктов: collectionStatus=unavailable, reasonCode=unsupported; список не усекается."
              },
              "defender": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "amRunningMode": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "passive",
                      "edr_block",
                      "sxs_passive",
                      "other"
                    ]
                  },
                  "realTimeProtectionEnabled": {
                    "type": "boolean"
                  }
                },
