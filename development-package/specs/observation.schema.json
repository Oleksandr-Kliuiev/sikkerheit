                    "statusSource": {
                      "type": "string",
                      "enum": [
                        "windows_security_center",
                        "defender"
                      ]
                    },
                    "rawState": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "productState",
                    "statusSource"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "productState": {
                            "const": "unknown"
                          }
                        },
                        "required": [
                          "productState"
                        ]
                      },
                      "then": {
                        "required": [
                          "rawState"
                        ],
