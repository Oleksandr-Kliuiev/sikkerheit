{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sikkerheit.example.invalid/m365/graph-observation.schema.json",
  "title": "Sikkerheit M365 Observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checkId": {
      "type": "string",
      "enum": [
        "M365-001",
        "M365-002",
        "M365-003",
        "M365-004",
        "M365-005",
        "M365-006",
        "M365-007"
      ]
    },
    "collectorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "subject": {
      "type": "object",
      "description": "Форма объекта задаётся по checkId (allOf)."
    },
    "observedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "collectionStatus": {
      "type": "string",
      "enum": [
        "collected",
        "unavailable"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "permission_denied",
        "temporary_error",
        "license_missing",
        "partial_data"
      ]
    }
  },
  "required": [
    "checkId",
    "collectorVersion",
    "subject",
    "observedAt",
    "collectionStatus"
  ],
  "oneOf": [
    {
      "properties": {
        "collectionStatus": {
          "const": "collected"
        }
      },
      "required": [
        "evidence"
      ],
      "not": {
        "required": [
          "reasonCode"
        ]
      }
    },
    {
      "properties": {
        "collectionStatus": {
          "const": "unavailable"
        }
      },
      "required": [
        "reasonCode"
      ],
      "not": {
        "required": [
          "evidence"
        ]
      }
    }
  ],
