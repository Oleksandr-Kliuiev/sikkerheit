                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F​-‏‪-‮⁦-⁩<>]+$"
              }
            },
            "required": [
              "type",
              "key",
              "userPrincipalName"
            ]
          }
        }
      }
    },
